resolver 127.0.0.11 valid=10s;

upstream gaia_api {
    server hr-api:8000 max_fails=1 fail_timeout=2s;
}

upstream gaia_console {
    server console:80;
}

upstream hr_console {
    server hr-frontend:4173;
}

upstream gaia_docs {
    server docs:4175;
}

server {
    listen 8080 default_server;
    server_name localhost 127.0.0.1;

    location = /health/live {
        access_log off;
        return 200 "ok\\n";
    }

    location = /console {
        return 308 /console/;
    }

    location /console/ {
        proxy_pass http://gaia_console/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /docs {
        return 308 /docs/;
    }

    location /docs/ {
        proxy_pass http://gaia_docs;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Prefix /docs;
    }

    location = /hr {
        return 308 /hr/;
    }

    location /hr/ {
        proxy_pass http://hr_console;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /demo/ {
        proxy_pass http://hr_console;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /v1/ {
        proxy_pass http://hr_console;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://gaia_api/;
        proxy_set_header X-Gaia-Api-Key "${GAIA_API_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 90s;
    }

    location / {
        proxy_pass http://gaia_console;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
